# Copy to .env at the root of the working tree. .env is git-ignored.
# A variable already set in the environment wins over this file.

# Any OpenAI-compatible endpoint. The campaign ran against MiniMax.
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=your-key-here

# Floor on the delay between two calls, in seconds. The sliding-window governor
# in textagents/llm/governor.py does the real rate limiting; this is a backstop.
LLM_MIN_INTERVAL_S=0.05

# Any field of textagents.config.Config can be overridden as TEXTAGENTS_<FIELD>.
# The value is coerced to the type of the committed default, so a misspelt value
# fails at startup instead of misconfiguring a run.
# TEXTAGENTS_MODEL=MiniMax-M2
# TEXTAGENTS_BUDGET_USD=25.0
# TEXTAGENTS_WORKERS=5
# TEXTAGENTS_REPLICATES=3
# TEXTAGENTS_DATA_DIR=data/processed
